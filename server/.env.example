# Optional. The API uses port 3001 when no .env file is present.
PORT=3001

# Copy this file to server/.env and replace the local database credentials.
# Encode special characters in the password as URL characters (for example, @ as %40).
DATABASE_URL=postgresql://quizzent:replace-with-local-password@127.0.0.1:5432/quizzent_dev

# Production uses NODE_ENV=production and serves the built React frontend too.
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# Set PUBLIC_ORIGIN only to override that URL, such as for a custom domain.
# PUBLIC_ORIGIN=https://your-app.onrender.com
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1
# Keep remote credentials in hosting secrets, never in this example file.
